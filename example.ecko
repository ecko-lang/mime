# mime - building a real message, end to end.
#
# Runs offline and prints the same bytes every time: the multipart boundary is
# derived from the content rather than randomised, and the SMTP transport is in
# mock mode, so nothing here touches the network.
#
#   ecko example.ecko

import "./main.ecko" as mime

# --- media types -------------------------------------------------------------

print("type_for:")
for name in ["report.pdf", "photo.PNG", "/srv/static/app.js", "notes", "backup.tar.gz"] {
    print("  {name} -> {mime.type_for(name)}")
}
print("extension_for(image/jpeg) -> {mime.extension_for(\"image/jpeg\")}")
print("")

# --- a plain message ---------------------------------------------------------

# One part, so no multipart wrapper: the message is just text/plain.
plain = mime.message(
    { from: "reports@example.com", to: "ada@example.com", subject: "Daily numbers" },
)
    |> mime.text("Everything is green.")

print("--- plain ---")
print(mime.to_string(plain))
print("")

# --- text, an HTML alternative, and an attachment -----------------------------

# Plain text first: a reader picks the last part it understands, so the richer
# alternative should come after the fallback.
report = bytes("%PDF-1.4\nnot really a pdf, but it attaches the same way\n")

full = mime.message(
    {
        from: "Reports <reports@example.com>",
        to: ["ada@example.com", "grace@example.com"],
        subject: "Daily numbers",
        headers: { "X-Report-Run": "2026-08-03" },
    },
)
    |> mime.text("Everything is green. The detail is attached.")
    |> mime.html("<p>Everything is <strong>green</strong>. The detail is attached.</p>")
    |> mime.attach("report.pdf", report)

print("--- multipart/mixed ---")
print(mime.to_string(full))
print("")

# --- handing it to a transport ------------------------------------------------

# `render` returns exactly the map an SMTP client's `send` takes - envelope
# fields, a header map, and the encoded body - so the two compose with no glue.
# Pass it straight to the `smtp` package.
wire = mime.render(full)

print("--- what a transport receives ---")
for k in sort(keys(wire.headers)) {
    print("{k}: {wire.headers[k]}")
}

# The header the transport must not touch: the message carries exactly one
# Content-Type, and it is the multipart one. A transport that appends its own
# text/plain leaves a multipart message with two, and it parses as neither - so
# `render` owns this header and the caller sends what it is given.
ct = wire.headers["Content-Type"]
print("Content-Type: {ct}")
